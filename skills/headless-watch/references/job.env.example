# ~/.claude/watchers/<name>/job.env  (sourced by bash: quote values with spaces or brackets)
PROJECT_DIR="$HOME/path/to/project"
MODEL=sonnet
GATE_MODEL=haiku
ALLOWED_TOOLS="Read,Grep,Glob,mcp__server__read_tool_one,mcp__server__read_tool_two,Bash(tail *)"
# The skill the check runs, read as a file (needs Read above; never list Skill there). plugin:name picks one plugin.
SKILL=watch-sheets
DAYS="1-5"
HOURS="9-19"
INTERVAL_MIN=10
ALERT=telegram
TELEGRAM_CHAT_ID=123456789
# ALERT=ntfy
# NTFY_TOPIC="long-random-topic-name"
# NTFY_SERVER="https://ntfy.sh"
MAX_BUDGET_USD=1
RUN_TIMEOUT_MIN=15
HEARTBEAT=daily
FAIL_ALERT_AFTER=2
# PATH="/extra/runtime/bin:$PATH"
