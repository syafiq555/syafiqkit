{
  "description": "Injects syafiqkit's output-style ruleset at session start, loads the syafiqkit menu mod, and blocks shell rewrites of repo files.",
  "modules": ["./src/mod.js"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": ["python3", "-I", "${CLAUDE_PLUGIN_ROOT}/hooks/block-scripted-writes.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/RULESET.md"],
            "timeout": 5,
            "statusMessage": "Loading syafiqkit output style..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/prune-caches.sh", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
