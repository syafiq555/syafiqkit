#!/bin/sh
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

bun=$(command -v bun 2>/dev/null)
for candidate in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
  [ -n "$bun" ] && break
  [ -x "$candidate" ] && bun=$candidate
done

if [ -z "$bun" ]; then
  echo "remote: bun not found (install it from https://bun.sh)" >&2
  exit 127
fi

exec "$bun" "$root/index.ts" "$@"
